# Copy to .env for local development. Values here are placeholders only.
# On Render these same keys are set under the service's Environment tab
# (see render.yaml and DEPLOY.md).

# Postgres. Locally the Supabase direct URI is fine; on Render use the
# Supabase "Session pooler" URI, which resolves over IPv4.
DATABASE_URL=postgresql://user:password@host:5432/postgres

SECRET_KEY=change-me
ALGORITHM=HS256

GEMINI_API_KEY=

# false/lax for http://localhost, true/lax once the API is served over HTTPS
# behind the same site as the frontend.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Comma separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,https://localhost:3000

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://localhost:8000/callback
SPOTIFY_SCOPES=user-follow-read user-read-recently-played user-top-read
SPOTIFY_POST_AUTH_REDIRECT=https://localhost:3000/dashboard/notes

# The Spotify cover backfill runs before the server binds its port; disable it
# where a slow cold start would fail the health check.
BACKFILL_SONG_COVERS_ON_STARTUP=true

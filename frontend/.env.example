# Local development (see docker-compose.yml). Copy to .env.local.
NEXT_PUBLIC_API_BASE_URL=https://localhost:8000

# On Vercel set these two instead, so the API is proxied through this app and
# the auth cookie stays first-party (see next.config.ts):
#   BACKEND_ORIGIN=https://<service>.onrender.com
#   NEXT_PUBLIC_API_BASE_URL=/api
